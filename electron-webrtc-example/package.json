{
  "name": "security-camera-agent",
  "version": "2.52.54",
  "description": "Electron Security Camera Agent with WebRTC Live View and Away Mode",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "electron-log": "^5.4.3",
    "electron-store": "7.0.3",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.yourdomain.securitycamera",
    "productName": "Security Camera Agent",
    "publish": [
      {
        "provider": "github",
        "owner": "ioranr1",
        "repo": "cozy-project"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "differentialPackage": false,
      "include": "installer.nsh",
      "artifactName": "Security-Camera-Agent-Setup-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Security-Camera-Agent.${ext}",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "icon": "icon.png"
    },
    "dmg": {
      "artifactName": "Security-Camera-Agent.${ext}"
    },
    "extraResources": [
      {
        "from": "icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "tray-icon@2x.png",
        "to": "tray-icon@2x.png"
      }
    ]
  },
  "author": "",
  "license": "MIT"
}
